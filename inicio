<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Quico's Burgers</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      font-family:'Poppins',sans-serif;
      background:#f5f3ef;
      color:#2b2b2b;
      line-height:1.6;
    }

    img{
      width:100%;
      display:block;
    }

    .hero{
      height:70vh;
      background:
      linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.55)),
      url('https://images.unsplash.com/photo-1568901346375-23c9450c58cd?q=80&w=1400&auto=format&fit=crop');
      background-size:cover;
      background-position:center;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      color:white;
      padding:20px;
    }

    .hero-content h1{
      font-family:'Playfair Display',serif;
      font-size:4rem;
      letter-spacing:2px;
      margin-bottom:15px;
    }

    .hero-content p{
      font-size:1.1rem;
      color:#e7e7e7;
    }

    .container{
      width:90%;
      max-width:1300px;
      margin:auto;
      padding:80px 0;
    }

    .section-title{
      font-family:'Playfair Display',serif;
      font-size:2.5rem;
      margin-bottom:50px;
      text-align:center;
      color:#3d342f;
      position:relative;
    }

    .section-title::after{
      content:'';
      width:80px;
      height:2px;
      background:#8d7b68;
      position:absolute;
      bottom:-12px;
      left:50%;
      transform:translateX(-50%);
    }

    .menu-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
      gap:35px;
    }

    .card{
      background:white;
      border-radius:22px;
      overflow:hidden;
      box-shadow:0 8px 30px rgba(0,0,0,0.08);
      transition:0.35s ease;
    }

    .card:hover{
      transform:translateY(-8px);
      box-shadow:0 15px 40px rgba(0,0,0,0.12);
    }

    .card-image{
      height:240px;
      overflow:hidden;
    }

    .card-image img{
      height:100%;
      object-fit:cover;
      transition:0.4s;
    }

    .card:hover .card-image img{
      transform:scale(1.05);
    }

    .card-content{
      padding:25px;
    }

    .card-header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:15px;
    }

    .card-header h3{
      font-size:1.5rem;
      color:#2d2d2d;
      font-weight:600;
    }

    .price{
      background:#3d342f;
      color:white;
      padding:8px 14px;
      border-radius:30px;
      font-size:0.95rem;
      font-weight:500;
    }

    .desc{
      color:#666;
      font-size:0.95rem;
      margin-bottom:15px;
    }

    .combo{
      color:#8d7b68;
      font-weight:600;
    }

    .extras{
      margin-top:80px;
      background:white;
      border-radius:25px;
      padding:50px;
      box-shadow:0 10px 30px rgba(0,0,0,0.06);
    }

    .extras-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:25px;
      margin-top:35px;
    }

    .extra-item{
      background:#f8f6f3;
      padding:30px;
      border-radius:18px;
      text-align:center;
      transition:0.3s;
    }

    .extra-item:hover{
      transform:translateY(-5px);
    }

    .extra-item h4{
      color:#3d342f;
      margin-bottom:10px;
      font-size:1.1rem;
    }

    .extra-item p{
      color:#8d7b68;
      font-weight:600;
      font-size:1.1rem;
    }

    footer{
      background:#2a2522;
      color:#ddd;
      text-align:center;
      padding:30px;
      margin-top:80px;
    }

    @media(max-width:768px){

      .hero{
        height:60vh;
      }

      .hero-content h1{
        font-size:2.7rem;
      }

      .section-title{
        font-size:2rem;
      }

      .card-image{
        height:220px;
      }

    }

  </style>
</head>
<body>

  <!-- HERO -->
